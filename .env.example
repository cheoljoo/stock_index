# Copy this file to .env and fill in your values
# Load with: export $(cat .env | xargs)   or use python-dotenv

# FRED API key (무료 발급: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# 한국은행 ECOS API key (무료 발급: https://ecos.bok.or.kr/api/#/DevGuide/DevGuide)
ECOS_API_KEY=your_ecos_api_key_here

# SMTP 비밀번호 (Gmail은 앱 비밀번호 사용 권장)
SMTP_PASSWORD=your_smtp_password_here

# KRX data.krx.co.kr 회원 로그인 (무료 가입: https://data.krx.co.kr)
# 데드캣 바운스 분석의 공매도·투자자별(외국인/기관/개인) 수급 데이터 조회에 필요합니다.
# 미설정 시 해당 데이터 없이 거래량·주가 기반 분석만 제공됩니다.
KRX_ID=your_krx_id_here
KRX_PW=your_krx_password_here

# KRX Open API 인증키 (https://openapi.krx.co.kr 에서 신청). 공식 경로라 차단 위험이 낮다.
KRX_OPENAPI_KEY=your_krx_openapi_key_here

# --- KRX(data.krx.co.kr, pykrx) 호출 안전장치 (선택, 기본값 권장) ---
# KRX는 자동화된 비정상 대량 조회를 감지하면 IP를 1일간 차단한다. 구체 기준은 비공개라 보수적으로 둔다.
# KRX_MIN_INTERVAL=1.5        # 호출 사이 최소 간격(초) + 0~0.5초 무작위 지연
# KRX_MAX_CALLS_PER_DAY=1500  # 하루 최대 호출 수(초과 시 그날은 캐시만 사용)
# KRX_CACHE_DIR=data/krx_cache  # 종목별 시계열 캐시 위치 (차단 기록은 그 상위의 krx_block.json)

# 메일의 "대시보드 열기" 링크 주소 (비우면 config/settings.yaml 의 site_url)
STOCK_INDEX_SITE_URL=
